# OpenAI API Key (required)
OPENAI_API_KEY=sk-your-key-here

# Model Configuration
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

# Database
DATABASE_URL=sqlite:///./hr_system.db

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Agent Configuration
RESUME_SHORTLIST_THRESHOLD=60
MAX_INTERVIEWS_PER_CANDIDATE=3

# Agent Guardrails
AGENT_RECURSION_LIMIT=25
AGENT_TIMEOUT_SECONDS=120
AGENT_MAX_RETRIES=2

# Logging
LOG_LEVEL=INFO
